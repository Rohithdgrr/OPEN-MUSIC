# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
app/src-tauri/target/
app/node_modules/
app/dist/
app/.vite/

# Tauri-generated schema dumps (recreated by `tauri dev`)
app/src-tauri/gen/schemas/

# ---------------------------------------------------------------------------
# Design archives — large binary Stitch exports.
# The extracted per-screen sources live in design/ and ARE tracked; only the
# untouched .zip downloads are kept out of history.
# ---------------------------------------------------------------------------
archives/
*.zip

# ---------------------------------------------------------------------------
# Local agent / editor config
# ---------------------------------------------------------------------------
.opencode/
.claude/
.vscode/
.idea/

# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------------
# Local scratch
# ---------------------------------------------------------------------------
*.log
*.tmp
.env
.env.local

app/src-tauri/.google-client-id
app/src-tauri/.spotify-client-id


# Android release signing — never commit the keystore
*.keystore
keystore.properties
# Build junk / signing secrets
langsplit_tmp.pdb
*.pdb
# Tauri regenerates the Android + Apple scaffolds from tauri.conf.json.
# gen/android holds a release.keystore + keystore.properties = signing secrets.
app/src-tauri/gen/
.playwright-mcp/
