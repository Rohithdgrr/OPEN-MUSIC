{
  "name": "trance-music",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "css": "tailwindcss -i tailwind.input.css -o src/tailwind.css --minify",
    "css:watch": "tailwindcss -i tailwind.input.css -o src/tailwind.css --watch",
    "lint": "eslint src",
    "dist:windows": "npm run css && tauri build --bundles nsis",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:smoke": "node ../tests/smoke-test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3"
  }
}
