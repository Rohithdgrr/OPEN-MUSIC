{
  "$schema": "../../gen/schemas/desktop-schema.json",
  "identifier": "widget-extras",
  "description": "Window controls the floating card may drive itself",
  "windows": ["widget"],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-set-always-on-top",
