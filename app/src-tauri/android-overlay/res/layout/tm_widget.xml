<?xml version="1.0" encoding="utf-8"?>
<!-- Homescreen player widget: artwork + title/artist + transport. Dark card
     matches the obsidian theme; framework media glyphs need no new assets. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tm_w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC16161A"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:id="@+id/tm_w_art"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="Artwork"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_launcher" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/tm_w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="OpenMusic"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tm_w_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Nothing playing"
            android:textColor="#A1A1AA"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/tm_w_prev"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Previous"
        android:src="@android:drawable/ic_media_previous" />

    <ImageButton
        android:id="@+id/tm_w_toggle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Play or pause"
        android:src="@android:drawable/ic_media_play" />

    <ImageButton
        android:id="@+id/tm_w_next"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Next"
        android:src="@android:drawable/ic_media_next" />
</LinearLayout>
