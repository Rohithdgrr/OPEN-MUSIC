{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TRANCE MUSIC",
  "version": "0.1.0",
  "identifier": "com.openmusic.trancemusic",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TRANCE MUSIC",
        "width": 1180,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
